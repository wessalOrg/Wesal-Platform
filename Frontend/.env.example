# Local API (development fallback when this variable is unset)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:5298/api/v1

# Production API override. OPTIONAL: when unset, production builds use the
# canonical Wesal API (https://wesal-platform-p0iv.onrender.com/api/v1).
# An explicit value must be an absolute https URL on Vercel production deploys.
# NEXT_PUBLIC_API_BASE_URL=https://wesal-platform-p0iv.onrender.com/api/v1

# Demo/mock fallbacks (fake halls, bookings, reviews, stub-token success).
# Local development only. NEVER set to "true" in production (the build fails).
# NEXT_PUBLIC_DEMO_MODE=true
